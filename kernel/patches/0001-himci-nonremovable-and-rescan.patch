+/* CV206: let user space request another scan (needed for non-removable SDIO
+ * devices such as the Wi-Fi chip, whose power/reset is toggled by hand):
+ *   echo 1 > /sys/class/mmc_host/mmc1/rescan
+ */
+static ssize_t himci_rescan_store(struct device *dev, struct device_attribute *a,
+				  const char *buf, size_t count)
+{
+	struct mmc_host *mmc = container_of(dev, struct mmc_host, class_dev);
+
+	mmc->rescan_entered = 0;
+	mmc_detect_change(mmc, 0);
+	return count;
+}
+static DEVICE_ATTR(rescan, 0200, NULL, himci_rescan_store);
